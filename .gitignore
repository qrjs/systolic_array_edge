# Allow-list strategy for clone-and-run
# 1. Ignore everything
*

# 2. Unignore directories so we can traverse them
!*/

# 3. Re-ignore specific directories we typically want to exclude
# (files inside these will be ignored because the parent is ignored)
vivado/
vivado_project/
.Xil/
reports/*
logs/
work/
sim/
outputs/
db/
ndm/
alib*/
/TSMC28/
/SMIC40/
/svdb/
/asic_commercial/pdk_cache/
/asic_commercial/*/frontsim/
/asic_commercial/*/postsim/suites/
/asic_commercial/*/results/
/formality_svf/
/asic_commercial/*/formality_svf/
/asic_commercial/*/gated_opt/
/asic_commercial/*/icc_output.txt
*OneSpin*
.vscode/
.idea/
.DS_Store

# 4. Unignore essential source files and documentation
!*.v
!*.sv
!*.vh
!*.svh
!*.tcl
!*.sh
!*.txt
!*.md
!*.f
!*.pdf
!*.png
!*.jpg
!*.jpeg
!*.sdc
!*.xdc
!*.c
!*.h
!*.cpp
!Makefile
!makefile
!.gitignore
!LICENSE
# --- 新增：允许跟踪综合报告和网表 ---
# 放行 reports 文件夹本身
!asic_commercial/syn/reports/
# 放行 reports 文件夹下所有的 .rpt 文件
!asic_commercial/syn/reports/**/*.rpt
!asic_commercial/syn/script/run.tcl
# (可选) 如果你还想跟踪综合出的网表和 SDC
!asic_commercial/syn/mapped/
!asic_commercial/syn/mapped/*.v
!asic_commercial/syn/mapped/*.sdc
# 5. Specifically ignore known generated files that might match above (if any)
# (e.g. if a .txt file is generated in the root, exclude it explicitly if needed)
# But generated folders like reports/ are already excluded.
!*.py
!asic_commercial/dip/config/design.legacy.env
!asic_commercial/dip/config/design.std.env
!asic_commercial/dip/config/libs.env
!asic_commercial/dip/config/libs.smic40.env
!asic_commercial/os/config/*.env
!asic_commercial/is/config/*.env
!asic_commercial/ws/config/*.env

# Thesis evidence summaries are small and useful for writing/review.
!reports/thesis/
reports/thesis/*
!reports/thesis/*.md
!reports/thesis/*.csv
!reports/thesis/runs/
reports/thesis/runs/*
!reports/thesis/runs/validation_summary.md
!reports/thesis/runs/validation_summary.csv

# Fixed thesis vectors are small enough to track and make validation reproducible.
!test_vectors/thesis/
!test_vectors/thesis/**/
!test_vectors/thesis/**/*.txt
!test_vectors/thesis/**/*.csv
!test_vectors/thesis/**/*.md

# 6. Ignore specific binary artifacts/files that shouldn't be tracked
sim

# 7. Ignore high-frequency generated artifacts explicitly
*.log
*.jou
*.backup.log
*.backup.jou
*.vcd
*.vvp
test_logs/
simple_sim.daidir/
sim_is
*_inputs.hex
*_weights.hex
*_expected.hex
test_vectors_*_100.json
*/tb/sim/
*/tb/sim_*
*/scripts/*sim*.log

# Root-level generated clutter should stay out of the source tree.
/command.log
/default.svf
/icc2_command.log
/icc2_output.txt
/innovus.cmd
/innovus.log
/innovus.logv
/ucli.key
/vc_hdrs.h
/csrc/
/verdiLog/
/*.mr
/*-verilog.pvl
/*-verilog.syn

# Generated commercial-flow payloads stay local unless explicitly archived
# outside git, e.g. Git LFS or release artifacts.
/asic_commercial/*/icc_output.txt
/asic_commercial/syn/mapped/thesis_*/

# Key raw thesis evidence: small report/log originals used by reports/thesis.
!reports/thesis/key_evidence.md
!reports/thesis/key_evidence.csv
!reports/thesis/runs/logs/
!reports/thesis/runs/logs/*.log

!asic_commercial/syn/reports/**/*.csv

!asic_commercial/ws/reports/
!asic_commercial/ws/reports/fm/
!asic_commercial/ws/reports/innovus/
!asic_commercial/ws/reports/calibre/
!asic_commercial/ws/reports/*_dc_plain_*.rpt
!asic_commercial/ws/reports/fm/*_summary.rpt
!asic_commercial/ws/reports/innovus/*.rpt
!asic_commercial/ws/reports/calibre/*_drc_backend.rep
!asic_commercial/ws/reports/calibre/*_drc_backend.results
!asic_commercial/ws/reports/calibre/*_lvs_ports_only_nostdlib.rep
!asic_commercial/ws/reports/calibre/*_lvs_ports_only_nostdlib.rep.ext

!asic_commercial/os/reports/
!asic_commercial/os/reports/fm/
!asic_commercial/os/reports/innovus/
!asic_commercial/os/reports/calibre/
!asic_commercial/os/reports/*_dc_plain_*.rpt
!asic_commercial/os/reports/fm/*_summary.rpt
!asic_commercial/os/reports/innovus/*.rpt
!asic_commercial/os/reports/calibre/*_drc_backend.rep
!asic_commercial/os/reports/calibre/*_drc_backend.results
!asic_commercial/os/reports/calibre/*_lvs_ports_only_nostdlib.rep
!asic_commercial/os/reports/calibre/*_lvs_ports_only_nostdlib.rep.ext

!asic_commercial/is/reports/
!asic_commercial/is/reports/fm/
!asic_commercial/is/reports/innovus/
!asic_commercial/is/reports/calibre/
!asic_commercial/is/reports/*_dc_plain_*.rpt
!asic_commercial/is/reports/fm/*_summary.rpt
!asic_commercial/is/reports/innovus/*.rpt
!asic_commercial/is/reports/calibre/*_drc_backend.rep
!asic_commercial/is/reports/calibre/*_drc_backend.results
!asic_commercial/is/reports/calibre/*_lvs_ports_only_nostdlib.rep
