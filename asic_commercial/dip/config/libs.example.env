# Copy this file to libs.env and edit only if your server differs from the
# default TSMC.90 sc-x setup below.

# -----------------------------------------------------------------------------
# DC libraries
# -----------------------------------------------------------------------------
TARGET_LIBRARY="/home/ic_libs/TSMC.90/aci/sc-x/synopsys/slow.db"
LINK_LIBRARY="* /home/ic_libs/TSMC.90/aci/sc-x/synopsys/slow.db"
MAX_CORES="8"
DC_USE_ULTRA="0"

# -----------------------------------------------------------------------------
# Gate-level simulation
# -----------------------------------------------------------------------------
SIM_LIBRARY_VERILOG="/home/ic_libs/TSMC.90/aci/sc-x/verilog/tsmc090.v"
ADDITIONAL_SIM_VERILOGS=""

# -----------------------------------------------------------------------------
# ICC2 technology and reference libraries
# -----------------------------------------------------------------------------
ICC2_TECH_FILE="/home/ic_libs/TSMC.90/aci/sc-x/astro/tf/tsmc090_6lm_1thick.tf"
# This server does not provide NDM. The current probe / ICC2 flow first tests
# whether ICC2 can consume the legacy Astro FRAM library directly.
ICC2_REFERENCE_LIBS="/home/ic_libs/TSMC.90/aci/sc-x/astro/tsmc090g_fram"
TLUPLUS_MAX=""
TLUPLUS_MIN=""
TLUPLUS_MAP=""
ICC2_OVERWRITE_LIB="1"

# -----------------------------------------------------------------------------
# Power and floorplan
# -----------------------------------------------------------------------------
POWER_NET="VDD"
GROUND_NET="VSS"
PLACE_SITE="unit"

FLOORPLAN_ASPECT_RATIO="1.0"
CORE_UTILIZATION="0.55"
CORE_MARGIN_LEFT="8"
CORE_MARGIN_BOTTOM="8"
CORE_MARGIN_RIGHT="8"
CORE_MARGIN_TOP="8"

RING_LAYER_H="metal8"
RING_LAYER_V="metal9"
RING_WIDTH="2.0"
RING_SPACING="1.0"
RING_OFFSET="1.0"

ADD_POWER_STRIPES="0"
STRIPE_LAYER="metal7"
STRIPE_WIDTH="1.2"
STRIPE_SPACING="0.8"
STRIPE_SET_TO_SET_DISTANCE="20.0"

# -----------------------------------------------------------------------------
# Clock tree and export
# -----------------------------------------------------------------------------
CTS_BUFFER_LIST=""
GDS_STREAM_OUT_MAP="/home/ic_libs/TSMC.90/aci/sc-x/astro/gds2OutLayer.map"

# -----------------------------------------------------------------------------
# Formality
# dc     : compare RTL against DC netlist
# icc2   : compare RTL against ICC2 exported netlist
# custom : compare RTL against CUSTOM_NETLIST
# -----------------------------------------------------------------------------
FM_IMPLEMENTATION_MODE="dc"

# -----------------------------------------------------------------------------
# Netlist source
# dc         : use results/<design>_dc.v from this runset
# custom     : use CUSTOM_NETLIST below
# -----------------------------------------------------------------------------
POSTSIM_NETLIST_MODE="dc"
ICC2_NETLIST_MODE="dc"
CUSTOM_NETLIST=""

# -----------------------------------------------------------------------------
# SDF source for gate-level simulation
# dc     : use results/<design>_dc.sdf
# icc2   : use results/icc2/<design>_icc2.sdf
# none   : gate-level sim without timing back-annotation
# custom : use CUSTOM_SDF below
# -----------------------------------------------------------------------------
POSTSIM_SDF_MODE="dc"
CUSTOM_SDF=""

# -----------------------------------------------------------------------------
# Calibre
# icc2   : use ICC2 exported GDS/netlist
# custom : use the custom path below
# -----------------------------------------------------------------------------
CALIBRE_DRC_RUNSET="/path/to/calibre_drc.runset"
CALIBRE_LVS_RUNSET="/path/to/calibre_lvs.runset"
CALIBRE_LAYOUT_MODE="icc2"
CALIBRE_SOURCE_MODE="icc2"
CALIBRE_CUSTOM_GDS=""
CALIBRE_CUSTOM_SOURCE_NETLIST=""

# -----------------------------------------------------------------------------
# Virtuoso stream-in defaults
# -----------------------------------------------------------------------------
# The current assumption is that the OA tech library name is "tsmc090".
# If strmin rejects this name, keep the exported GDS and attach/import manually.
VIRTUOSO_TECH_LIB="tsmc090"
