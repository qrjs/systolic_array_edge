# Copy this file to libs.env if you want a separate local copy.
# The thesis flow only requires one variable before running:
#
#   export TSMC90_ROOT=/home/ic_libs/TSMC.90
#
# Optional:
#   export ICC_SHELL_EXEC=/absolute/path/to/icc_shell

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/libs.tsmc90.env"
