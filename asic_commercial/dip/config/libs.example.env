# Copy this file to libs.env if you want a separate local copy.
# The Cadence thesis flow only requires one variable before running:
#
#   export SMIC40_PDK_ROOT=/absolute/path/to/pdk
#
# Optional:
#   export INNOVUS_BIN=/absolute/path/to/innovus
#   export VIRTUOSO_TECH_LIB=<oa_tech_lib_name>

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/libs.smic40.env"
