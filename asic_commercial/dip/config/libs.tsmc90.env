# External TSMC.90 digital flow template.
# Usage:
#   export TSMC90_ROOT=/home/ic_libs/TSMC.90
#   (optional) export ICC_SHELL_EXEC=/path/to/icc_shell
#
# Default thesis line:
#   cell family = tpdn90g3_130a
#   metal stack = 6lm
#   tech file   = 1thick

: "${TSMC90_ROOT:?TSMC90_ROOT must point to the extracted TSMC.90 root}"
TSMC90_ROOT="${TSMC90_ROOT%/}"
case "${TSMC90_ROOT}" in
    *[[:space:]]*)
        echo "[dip-flow][ERROR] TSMC90_ROOT contains whitespace: ${TSMC90_ROOT}" >&2
        echo "[dip-flow][ERROR] Move or symlink the PDK to a path without spaces, then retry." >&2
        return 1 2>/dev/null || exit 1
        ;;
esac

TSMC90_FE_ROOT="${TSMC90_FE_ROOT:-${TSMC90_ROOT}/fe_TSMCHOME_tpdn90g3_130a}"
TSMC90_BE_ROOT="${TSMC90_BE_ROOT:-${TSMC90_FE_ROOT}/digital/Back_End}"
TSMC90_MW_ROOT="${TSMC90_MW_ROOT:-${TSMC90_BE_ROOT}/milkyway/tpdn90g3_130a/6lm}"
TSMC90_MW_LIB="${TSMC90_MW_LIB:-${TSMC90_MW_ROOT}/frame_only/tpdn90g3}"
TSMC90_ASTRO_ROOT="${TSMC90_ASTRO_ROOT:-${TSMC90_ROOT}/aci/sc-x/astro}"

TARGET_LIBRARY="${TARGET_LIBRARY:-${TSMC90_FE_ROOT}/digital/Front_End/timing_power/tpdn90g3_130a/tpdn90g3tc.db}"
LINK_LIBRARY="${LINK_LIBRARY:-* ${TARGET_LIBRARY}}"
MAX_CORES="${MAX_CORES:-8}"
DC_USE_ULTRA="${DC_USE_ULTRA:-0}"

SIM_LIBRARY_VERILOG="${SIM_LIBRARY_VERILOG:-${TSMC90_FE_ROOT}/digital/Front_End/verilog/tpdn90g3_130a/tpdn90g3.v}"
ADDITIONAL_SIM_VERILOGS="${ADDITIONAL_SIM_VERILOGS:-}"

ICC2_TECH_FILE="${ICC2_TECH_FILE:-${TSMC90_ASTRO_ROOT}/tf/tsmc090_6lm_1thick.tf}"
ICC2_REFERENCE_LIBS="${ICC2_REFERENCE_LIBS:-${TSMC90_MW_LIB}}"
TLUPLUS_MAX="${TLUPLUS_MAX:-}"
TLUPLUS_MIN="${TLUPLUS_MIN:-}"
TLUPLUS_MAP="${TLUPLUS_MAP:-}"
ICC2_OVERWRITE_LIB="${ICC2_OVERWRITE_LIB:-1}"
ICC2_CREATE_LIB_MODE="${ICC2_CREATE_LIB_MODE:-ref_only}"

POWER_NET="${POWER_NET:-VDD}"
GROUND_NET="${GROUND_NET:-VSS}"
PLACE_SITE="${PLACE_SITE:-}"

FLOORPLAN_ASPECT_RATIO="${FLOORPLAN_ASPECT_RATIO:-1.0}"
CORE_UTILIZATION="${CORE_UTILIZATION:-0.55}"
CORE_MARGIN_LEFT="${CORE_MARGIN_LEFT:-8}"
CORE_MARGIN_BOTTOM="${CORE_MARGIN_BOTTOM:-8}"
CORE_MARGIN_RIGHT="${CORE_MARGIN_RIGHT:-8}"
CORE_MARGIN_TOP="${CORE_MARGIN_TOP:-8}"

RING_LAYER_H="${RING_LAYER_H:-M5}"
RING_LAYER_V="${RING_LAYER_V:-M6}"
RING_WIDTH="${RING_WIDTH:-2.0}"
RING_SPACING="${RING_SPACING:-1.0}"
RING_OFFSET="${RING_OFFSET:-1.0}"

ADD_POWER_STRIPES="${ADD_POWER_STRIPES:-0}"
STRIPE_LAYER="${STRIPE_LAYER:-M4}"
STRIPE_WIDTH="${STRIPE_WIDTH:-1.2}"
STRIPE_SPACING="${STRIPE_SPACING:-0.8}"
STRIPE_SET_TO_SET_DISTANCE="${STRIPE_SET_TO_SET_DISTANCE:-20.0}"

CTS_BUFFER_LIST="${CTS_BUFFER_LIST:-}"
GDS_STREAM_OUT_MAP="${GDS_STREAM_OUT_MAP:-${TSMC90_MW_ROOT}/gdsout.map}"

FM_IMPLEMENTATION_MODE="${FM_IMPLEMENTATION_MODE:-dc}"
POSTSIM_NETLIST_MODE="${POSTSIM_NETLIST_MODE:-dc}"
ICC2_NETLIST_MODE="${ICC2_NETLIST_MODE:-dc}"
CUSTOM_NETLIST="${CUSTOM_NETLIST:-}"
POSTSIM_SDF_MODE="${POSTSIM_SDF_MODE:-dc}"
CUSTOM_SDF="${CUSTOM_SDF:-}"

CALIBRE_DRC_RUNSET="${CALIBRE_DRC_RUNSET:-}"
CALIBRE_LVS_RUNSET="${CALIBRE_LVS_RUNSET:-}"
CALIBRE_LAYOUT_MODE="${CALIBRE_LAYOUT_MODE:-icc2}"
CALIBRE_SOURCE_MODE="${CALIBRE_SOURCE_MODE:-icc2}"
CALIBRE_CUSTOM_GDS="${CALIBRE_CUSTOM_GDS:-}"
CALIBRE_CUSTOM_SOURCE_NETLIST="${CALIBRE_CUSTOM_SOURCE_NETLIST:-}"

VIRTUOSO_TECH_LIB="${VIRTUOSO_TECH_LIB:-}"
