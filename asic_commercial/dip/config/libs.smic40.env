# External SMIC40 PDK template.
# Usage:
#   export SMIC40_PDK_ROOT=/absolute/path/to/pdk
#   (optional) export INNOVUS_BIN=/path/to/innovus

: "${SMIC40_PDK_ROOT:?SMIC40_PDK_ROOT must point to the extracted SMIC40 PDK root}"
SMIC40_PDK_ROOT="${SMIC40_PDK_ROOT%/}"
case "${SMIC40_PDK_ROOT}" in
    *[[:space:]]*)
        echo "[dip-flow][ERROR] SMIC40_PDK_ROOT contains whitespace: ${SMIC40_PDK_ROOT}" >&2
        echo "[dip-flow][ERROR] Move or symlink the PDK to a path without spaces, then retry." >&2
        return 1 2>/dev/null || exit 1
        ;;
esac

pick_first_match() {
    local root="$1"
    shift
    local pattern
    local match
    for pattern in "$@"; do
        match="$(find "$root" -path "*/.*" -prune -o -type f -name "$pattern" -print -quit 2>/dev/null || true)"
        if [[ -n "$match" ]]; then
            printf '%s\n' "$match"
            return 0
        fi
    done
    return 1
}

pick_first_dir_match() {
    local root="$1"
    shift
    local pattern
    local match
    for pattern in "$@"; do
        match="$(find "$root" -path "*/.*" -prune -o -type d -name "$pattern" -print -quit 2>/dev/null || true)"
        if [[ -n "$match" ]]; then
            printf '%s\n' "$match"
            return 0
        fi
    done
    return 1
}

collect_path_list() {
    local root="$1"
    shift
    local pattern
    local matches=()
    local item
    for pattern in "$@"; do
        while IFS= read -r item; do
            [[ -n "$item" ]] || continue
            matches+=("$item")
        done < <(find "$root" -path "*/.*" -prune -o -type f -name "$pattern" -print 2>/dev/null || true)
        if [[ "${#matches[@]}" -gt 0 ]]; then
            break
        fi
    done
    if [[ "${#matches[@]}" -eq 0 ]]; then
        return 1
    fi
    printf '%s\n' "${matches[@]}" | awk '!seen[$0]++' | paste -sd ' ' -
}

is_probable_tech_lef() {
    local path="$1"
    local lower_path
    local base
    lower_path="$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')"
    base="$(basename "$lower_path")"

    case "$lower_path" in
        *.tlef | *.techlef | *"/techlef/"* | *"/technology/"* | *"/tech/"*)
            return 0
            ;;
    esac

    case "$base" in
        *tech*.lef | *technology*.lef)
            return 0
            ;;
    esac

    if head -n 200 "$path" 2>/dev/null | grep -Eq 'TYPE[[:space:]]+ROUTING|TYPE[[:space:]]+CUT'; then
        return 0
    fi

    return 1
}

pick_first_innovus_tech_lef() {
    local root="$1"
    local candidate

    candidate="$(
        pick_first_match "$root" \
            "*.tlef" \
            "*.TLEF" \
            "*tech*.lef" \
            "*Tech*.lef" \
            "*technology*.lef" \
            "*Technology*.lef" \
        || true
    )"
    if [[ -n "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi

    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        if is_probable_tech_lef "$candidate"; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done < <(find "$root" -path "*/.*" -prune -o -type f \( -iname "*.lef" -o -iname "*.tlef" \) -print 2>/dev/null || true)

    return 1
}

collect_innovus_lefs() {
    local match
    local files=()

    while IFS= read -r match; do
        [[ -n "$match" ]] || continue
        if is_probable_tech_lef "$match"; then
            continue
        fi
        files+=("$match")
    done < <(find "${SMIC40_PDK_ROOT}" -path "*/.*" -prune -o -type f \( -iname "*.lef" -o -iname "*.tlef" \) -print 2>/dev/null || true)

    if [[ "${#files[@]}" -eq 0 ]]; then
        return 1
    fi
    printf '%s\n' "${files[@]}" | awk '!seen[$0]++' | paste -sd ' ' -
}

if [[ -z "${SMIC40_STD_ROOT:-}" ]]; then
    if [[ -d "${SMIC40_PDK_ROOT}/pdk/sc9mc_base_rvt_c40/r1p1" ]]; then
        SMIC40_STD_ROOT="${SMIC40_PDK_ROOT}/pdk/sc9mc_base_rvt_c40/r1p1"
    else
        SMIC40_STD_ROOT="${SMIC40_PDK_ROOT}/sc9mc_base_rvt_c40/r1p1"
    fi
fi

if [[ -z "${SMIC40_OA_ROOT:-}" ]]; then
    if [[ -d "${SMIC40_PDK_ROOT}/pdk/40nm_TF/PDK/SPDK40LL_1125_1TM_OA_CDS_V1.4/smic40ll_1125_1tm_oa_cds_1P9M_2012_10_11_v1.4" ]]; then
        SMIC40_OA_ROOT="${SMIC40_PDK_ROOT}/pdk/40nm_TF/PDK/SPDK40LL_1125_1TM_OA_CDS_V1.4/smic40ll_1125_1tm_oa_cds_1P9M_2012_10_11_v1.4"
    else
        SMIC40_OA_ROOT="${SMIC40_PDK_ROOT}/40nm_TF/PDK/SPDK40LL_1125_1TM_OA_CDS_V1.4/smic40ll_1125_1tm_oa_cds_1P9M_2012_10_11_v1.4"
    fi
fi

DEFAULT_TARGET_LIBRARY="${SMIC40_STD_ROOT}/db/sc9mc_logic0040ll_base_rvt_c40_tt_typical_max_1p10v_25c.db"
if [[ ! -f "$DEFAULT_TARGET_LIBRARY" ]]; then
    DEFAULT_TARGET_LIBRARY="$(
        pick_first_match "${SMIC40_PDK_ROOT}" \
            "sc9mc_logic0040ll_base_rvt_c40_tt_typical_max_1p10v_25c.db" \
            "sc9mc_logic0040ll_base_rvt_c40_*typical*.db" \
            "sc9mc_logic0040ll_base_rvt_c40*.db" \
            "*.db" \
        || true
    )"
fi
TARGET_LIBRARY="${TARGET_LIBRARY:-${DEFAULT_TARGET_LIBRARY}}"
LINK_LIBRARY="${LINK_LIBRARY:-* ${TARGET_LIBRARY}}"
MAX_CORES="${MAX_CORES:-8}"
DC_USE_ULTRA="${DC_USE_ULTRA:-0}"

DEFAULT_SIM_LIBRARY_VERILOG="${SMIC40_STD_ROOT}/verilog/sc9mc_logic0040ll_base_rvt_c40.v"
if [[ ! -f "$DEFAULT_SIM_LIBRARY_VERILOG" ]]; then
    DEFAULT_SIM_LIBRARY_VERILOG="$(
        pick_first_match "${SMIC40_PDK_ROOT}" \
            "sc9mc_logic0040ll_base_rvt_c40.v" \
            "sc9mc_logic0040ll_base_rvt_c40*.v" \
            "*.v" \
        || true
    )"
fi
SIM_LIBRARY_VERILOG="${SIM_LIBRARY_VERILOG:-${DEFAULT_SIM_LIBRARY_VERILOG}}"
ADDITIONAL_SIM_VERILOGS="${ADDITIONAL_SIM_VERILOGS:-}"

DEFAULT_INNOVUS_TECH_LEF="$(pick_first_innovus_tech_lef "${SMIC40_PDK_ROOT}" || true)"
if [[ -z "${DEFAULT_INNOVUS_TECH_LEF}" && -n "${DEFAULT_INNOVUS_LEF_FILES:-}" ]]; then
    for item in ${DEFAULT_INNOVUS_LEF_FILES}; do
        DEFAULT_INNOVUS_TECH_LEF="$item"
        break
    done
fi
INNOVUS_TECH_LEF="${INNOVUS_TECH_LEF:-${DEFAULT_INNOVUS_TECH_LEF}}"

DEFAULT_INNOVUS_LEF_FILES="$(collect_innovus_lefs || true)"
INNOVUS_LEF_FILES="${INNOVUS_LEF_FILES:-${DEFAULT_INNOVUS_LEF_FILES}}"

DEFAULT_INNOVUS_LIB_MAX="${TARGET_LIBRARY}"
DEFAULT_INNOVUS_LIB_MIN="$(
    pick_first_match "${SMIC40_PDK_ROOT}" \
        "sc9mc_logic0040ll_base_rvt_c40_*min*.db" \
        "sc9mc_logic0040ll_base_rvt_c40_*hold*.db" \
        "sc9mc_logic0040ll_base_rvt_c40_*ff*.db" \
        "*min*.db" \
        "*hold*.db" \
        "*ff*.db" \
    || true
)"
if [[ -z "${DEFAULT_INNOVUS_LIB_MIN}" ]]; then
    DEFAULT_INNOVUS_LIB_MIN="${DEFAULT_INNOVUS_LIB_MAX}"
fi
INNOVUS_LIB_MAX="${INNOVUS_LIB_MAX:-${DEFAULT_INNOVUS_LIB_MAX}}"
INNOVUS_LIB_MIN="${INNOVUS_LIB_MIN:-${DEFAULT_INNOVUS_LIB_MIN}}"

DEFAULT_INNOVUS_QRC_TECH_FILE="$(
    pick_first_match "${SMIC40_PDK_ROOT}" \
        "*.qrcTechFile" \
        "*.tch" \
        "*.ict" \
        "*qrc*.tf" \
        "*Quantus*.tf" \
    || true
)"
INNOVUS_QRC_TECH_FILE="${INNOVUS_QRC_TECH_FILE:-${DEFAULT_INNOVUS_QRC_TECH_FILE}}"

DEFAULT_ICC2_TECH_FILE="${SMIC40_PDK_ROOT}/smic40ll/techfile.tf"
if [[ ! -f "$DEFAULT_ICC2_TECH_FILE" ]]; then
    DEFAULT_ICC2_TECH_FILE="$(
        pick_first_match "${SMIC40_PDK_ROOT}" \
            "techfile.tf" \
            "*.tf" \
        || true
    )"
fi
ICC2_TECH_FILE="${ICC2_TECH_FILE:-${DEFAULT_ICC2_TECH_FILE}}"

DEFAULT_ICC2_REFERENCE_LIBS="${SMIC40_STD_ROOT}/milkyway/1P9M_1TM/sc9mc_logic0040ll_base_rvt_c40"
if [[ ! -d "$DEFAULT_ICC2_REFERENCE_LIBS" ]]; then
    DEFAULT_ICC2_REFERENCE_LIBS="$(
        pick_first_dir_match "${SMIC40_PDK_ROOT}" \
            "sc9mc_logic0040ll_base_rvt_c40" \
            "1P9M_1TM" \
            "sc9mc_logic0040ll_base_rvt_c40" \
            "*.mw" \
            "*.milkyway" \
            "*.ndm" \
        || true
    )"
fi
ICC2_REFERENCE_LIBS="${ICC2_REFERENCE_LIBS:-${DEFAULT_ICC2_REFERENCE_LIBS}}"
ICC_REFERENCE_LIBS="${ICC_REFERENCE_LIBS:-${ICC2_REFERENCE_LIBS}}"

DEFAULT_ICC_TECH_FILE=""
if [[ -d "${SMIC40_PDK_ROOT}/pdk" ]]; then
    DEFAULT_ICC_TECH_FILE="$(
        pick_first_match "${SMIC40_PDK_ROOT}/pdk" \
            "icc*.tf" \
            "*astro*.tf" \
        || true
    )"
fi
if [[ -z "$DEFAULT_ICC_TECH_FILE" ]]; then
    DEFAULT_ICC_TECH_FILE="$(
        pick_first_match "${SMIC40_PDK_ROOT}" \
            "icc*.tf" \
            "*astro*.tf" \
        || true
    )"
fi
ICC_TECH_FILE="${ICC_TECH_FILE:-${DEFAULT_ICC_TECH_FILE}}"
TLUPLUS_MAX="${TLUPLUS_MAX:-}"
TLUPLUS_MIN="${TLUPLUS_MIN:-}"
TLUPLUS_MAP="${TLUPLUS_MAP:-}"
ICC2_OVERWRITE_LIB="${ICC2_OVERWRITE_LIB:-1}"

POWER_NET="${POWER_NET:-VDD}"
GROUND_NET="${GROUND_NET:-VSS}"
PLACE_SITE="${PLACE_SITE:-sc9mc_logic0040ll}"

FLOORPLAN_ASPECT_RATIO="${FLOORPLAN_ASPECT_RATIO:-1.0}"
CORE_UTILIZATION="${CORE_UTILIZATION:-0.55}"
CORE_MARGIN_LEFT="${CORE_MARGIN_LEFT:-8}"
CORE_MARGIN_BOTTOM="${CORE_MARGIN_BOTTOM:-8}"
CORE_MARGIN_RIGHT="${CORE_MARGIN_RIGHT:-8}"
CORE_MARGIN_TOP="${CORE_MARGIN_TOP:-8}"

RING_LAYER_H="${RING_LAYER_H:-metal8}"
RING_LAYER_V="${RING_LAYER_V:-metal9}"
RING_WIDTH="${RING_WIDTH:-2.0}"
RING_SPACING="${RING_SPACING:-1.0}"
RING_OFFSET="${RING_OFFSET:-1.0}"

ADD_POWER_STRIPES="${ADD_POWER_STRIPES:-0}"
STRIPE_LAYER="${STRIPE_LAYER:-metal7}"
STRIPE_WIDTH="${STRIPE_WIDTH:-1.2}"
STRIPE_SPACING="${STRIPE_SPACING:-0.8}"
STRIPE_SET_TO_SET_DISTANCE="${STRIPE_SET_TO_SET_DISTANCE:-20.0}"

CTS_BUFFER_LIST="${CTS_BUFFER_LIST:-}"
DEFAULT_GDS_STREAM_OUT_MAP="${SMIC40_OA_ROOT}/stream/Smic_Virtuoso_0040_LogicLL_TF.map"
if [[ ! -f "$DEFAULT_GDS_STREAM_OUT_MAP" ]]; then
    DEFAULT_GDS_STREAM_OUT_MAP="$(
        pick_first_match "${SMIC40_PDK_ROOT}" \
            "Smic_Virtuoso_0040_LogicLL_TF.map" \
            "*.map" \
        || true
    )"
fi
GDS_STREAM_OUT_MAP="${GDS_STREAM_OUT_MAP:-${DEFAULT_GDS_STREAM_OUT_MAP}}"
INNOVUS_GDS_MAP="${INNOVUS_GDS_MAP:-${GDS_STREAM_OUT_MAP}}"
VIRTUOSO_STREAM_MAP="${VIRTUOSO_STREAM_MAP:-${DEFAULT_GDS_STREAM_OUT_MAP}}"

FM_IMPLEMENTATION_MODE="${FM_IMPLEMENTATION_MODE:-dc}"
POSTSIM_NETLIST_MODE="${POSTSIM_NETLIST_MODE:-dc}"
POSTSIM_STAGES="${POSTSIM_STAGES:-none dc innovus}"
INNOVUS_NETLIST_MODE="${INNOVUS_NETLIST_MODE:-dc}"
ICC2_NETLIST_MODE="${ICC2_NETLIST_MODE:-dc}"
CUSTOM_NETLIST="${CUSTOM_NETLIST:-}"
POSTSIM_SDF_MODE="${POSTSIM_SDF_MODE:-dc}"
CUSTOM_SDF="${CUSTOM_SDF:-}"

CALIBRE_DRC_RUNSET="${CALIBRE_DRC_RUNSET:-${SMIC40_OA_ROOT}/Calibre/DRC/SmicDR3R_cal40_log_ll_sali_p1mx_1tm_121825.drc}"
CALIBRE_LVS_RUNSET="${CALIBRE_LVS_RUNSET:-${SMIC40_OA_ROOT}/Calibre/LVS/SmicSP1RR1R_cal40_LLRF_sali_plmtx_11182533_V1.4_0R_CCI.lvs}"
CALIBRE_LAYOUT_MODE="${CALIBRE_LAYOUT_MODE:-innovus}"
CALIBRE_SOURCE_MODE="${CALIBRE_SOURCE_MODE:-innovus}"
CALIBRE_CUSTOM_GDS="${CALIBRE_CUSTOM_GDS:-}"
CALIBRE_CUSTOM_SOURCE_NETLIST="${CALIBRE_CUSTOM_SOURCE_NETLIST:-}"

VIRTUOSO_TECH_LIB="${VIRTUOSO_TECH_LIB:-smic40ll}"
